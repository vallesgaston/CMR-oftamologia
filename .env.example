# --- Agenda ---
# Franjas separadas por coma (HH:MM-HH:MM)
FRANJAS_HORARIAS=09:00-13:00,15:00-19:00
# 0=lunes ... 6=domingo
DIAS_LABORALES=0,1,2,3,4
DURACION_TURNO_MIN=20
MAX_TURNOS_DIA=5
ANTICIPACION_MIN_HORAS=2
