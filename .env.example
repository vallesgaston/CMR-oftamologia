TZ=America/Argentina/Buenos_Aires

# --- Seguridad del panel (cambiar en producción) ---
ADMIN_TOKEN=cambiar-esto

# Cargar datos de ejemplo al iniciar si la base está vacía
SEED_DEMO=true

# --- Datos del consultorio (los usa el bot) ---
NOMBRE_CONSULTORIO=Consultorio Oftalmológico Dr. Ejemplo
